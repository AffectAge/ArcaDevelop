{
  "name": "arcanorum-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-esbuild.cjs",
    "dev": "concurrently \"npm run dev -w @arcanorum/server\" \"npm run dev -w @arcanorum/client\"",
    "build": "npm run build -ws",
    "lint": "npm run lint -ws && eslint scripts --cache --cache-location node_modules/.cache/eslint-scripts",
    "lint:all": "eslint .",
    "format:check": "prettier --check .",
    "map:from-geojson": "node scripts/prepare-map-from-geojson.mjs",
    "map-assets:build": "node scripts/build-phaser-map-atlases.mjs",
    "map-assets:terrain-choices": "node scripts/build-terrain-choice-hexes.mjs",
    "map:perf:fixtures": "tsx scripts/build-hex-map-perf-fixtures.ts",
    "map:perf": "tsx scripts/measure-hex-map-performance.mjs",
    "typecheck": "npm run typecheck -ws",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "echo integration tests not implemented",
    "test:e2e": "echo e2e tests not implemented",
    "docs:check": "node scripts/check-docs.mjs && tsx scripts/check-project-rules.ts && tsx scripts/check-code-guards.ts",
    "scenario:validate": "tsx apps/server/scripts/scenario-validate.ts",
    "scenario:build-indexes": "tsx apps/server/scripts/scenario-build-indexes.ts",
    "scenario:generate-map": "tsx apps/server/scripts/scenario-generate-map.ts",
    "verify": "npm run prisma:generate -w @arcanorum/server && npm run typecheck -ws && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "markdown-link-check": "^3.14.2",
    "prettier": "^3.8.4",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
