  "nonNegotiableRules": [
    "Do not add province-level heavy mechanics without explicit approval.",
    "Heavy mechanics belong to state regions.",
    "The server is authoritative for game decisions.",
    "AI countries use normal validated orders.",
    "No hidden gameplay fallback.",
    "New mechanics require player-visible UI, explanatory tooltips, and explanation trails for important visible values.",
    "Country-level resource mutations must go through resource ledger flows; only resource ledger runtime and world normalizers apply final resourcesByCountry totals.",
    "Concrete gameplay content must be scenario-authored data, not hardcoded core simulation branches.",
    "Bonuses, penalties, multipliers, and rule changes must use the shared modifier system.",
    "All visible UI text uses localization keys with English and Russian values.",
    "Balance and pacing values belong in scenario defines.",
    "Scenario-owned data/assets stay under scenario ownership.",
    "Scenario-authored data uses strict JSON, one entity per file, authoritative JSON id fields, and stable-ID references.",
    "Do not add backwards compatibility for old DB rows, saves, legacy content fields, old scenario layouts, aliases, or migration fallbacks unless explicitly requested as a separate compatibility decision.",
    "Authored scenario assets use stable asset:* registry ids; authored content must not store logoUrl, flagUrl, crestUrl, external URLs, or direct scenario asset URLs.",
    "Scenario generated indexes live under scenarios/<scenarioId>/.generated/ and are not authored source.",
    "Privileged behavior must be enforced server-side.",
    "Major architecture/protocol/persistence/AI/dependency/world-model/scenario decisions require an ADR."
  ],
  "forbiddenPatterns": [
    "hardcoded player-facing UI text",
    "hardcoded UI colors or theme values",
    "hardcoded balance numbers in code",
    "hidden visible-value calculations without tooltips or explanation records",
    "direct country resource mutations outside resource ledger runtime or world normalizers",
    "hardcoded concrete gameplay content instead of scenario-authored data",
    "mechanic-specific bonus or penalty conditionals that bypass the shared modifier system",
    "new province-level population/buildings/construction/resources/colonization/diplomacy transfer",
    "authored aggregate map/provinces.json or monolithic scenario content libraries in the target scenario format",
    "root apps/server/data/content-library.json legacy content library",
    "backwards compatibility layers for old saves/schema/runtime state without explicit separate approval",
    "authored scenario logoUrl/flagUrl/crestUrl/external URL fields instead of stable asset:* references",
    "manual edits to scenarios/<scenarioId>/.generated/",
    "admin/security checks only on the client",
    "upload flow without owner, scenario scope, validation, and cleanup lifecycle",
    "AI direct world-state mutation",
    "raw server errors exposed to players",
    "unjustified full-world scans in hot paths",
    "destructive operations without confirmation/audit/dry-run where practical",
    "new dependency without approval and rationale",
    "dead code/data/assets/docs/tests after mechanic removal",
    "any/@ts-ignore/broad casts outside boundary adapters",
    "secrets/tokens/passwords/private data in logs/docs/code",
    "vague folder names such as misc/helpers/stuff/random/newMechanicStuff"
  ],
  "verificationDefaults": [
    "npm run typecheck -ws",
    "relevant tests when available",
    "scenario validator when scenario/content/regions/AI/localization/assets change",
    "manual scenario notes for gameplay mechanics"
  ],
