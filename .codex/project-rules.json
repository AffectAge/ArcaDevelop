    "buildingContentFields": {
      "path": "scenarios/<scenarioId>/common/buildings/*.json",
      "flowFields": {
        "inputs": {
          "itemFields": ["goodId", "amount", "affectedByFertility", "minLevel", "maxLevel"],
          "levelBounds": { "type": "integerOrNull", "min": 1, "rule": "maxLevel >= minLevel when both are set" }
